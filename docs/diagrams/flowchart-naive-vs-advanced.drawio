<mxfile host="app.diagrams.net" modified="2026-07-28T00:00:00.000Z" agent="TECHSpherex-AI" version="24.0.0" type="device">
  <diagram name="Naive RAG gay o dau" id="naive-vs-adv">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="core" value="&lt;b&gt;NAIVE RAG&lt;/b&gt;&lt;br&gt;khớp câu hỏi với chunk bằng&lt;br&gt;&lt;b&gt;MỘT&lt;/b&gt; phép so vector duy nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Segoe UI;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="người hỏi dùng từ ngữ&lt;br&gt;khác hẳn tài liệu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="viết lại / mở rộng câu hỏi&lt;br&gt;&lt;b&gt;HyDE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="câu trả lời nằm rải&lt;br&gt;nhiều chunk?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="220" width="240" height="100" as="geometry" />
