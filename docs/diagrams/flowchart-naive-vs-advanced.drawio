          <mxGeometry x="330" y="380" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d3" value="thứ hạng top-k&lt;br&gt;không chuẩn?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="220" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="mô hình &lt;b&gt;rerank&lt;/b&gt;&lt;br&gt;chấm lại k đoạn đã lấy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="600" y="380" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="d4" value="câu hỏi cần suy luận&lt;br&gt;nhiều bước?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="220" width="150" height="100" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;truy hồi nhiều vòng&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="870" y="380" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b&gt;Vì sao tool này CỐ TÌNH không có mấy kỹ thuật trên&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mỗi kỹ thuật advanced chỉ dễ hiểu khi đã thấy tận mắt chỗ naive RAG hụt hơi. Học ngược lại — cài&lt;br&gt;rerank rồi mới hỏi &quot;nó vá cái gì?&quot; — thì chỉ nhớ được tên kỹ thuật chứ không hiểu vấn đề." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="500" width="960" height="90" as="geometry" />
        </mxCell>

        <mxCell id="how" value="&lt;b&gt;Cách thấy naive RAG hụt hơi ngay trong app&lt;/b&gt;&lt;br&gt;&lt;br&gt;· Hỏi &quot;Cách nấu phở bò&quot; — tài liệu không có câu trả lời, nhưng nó vẫn trả về đủ k đoạn.&lt;br&gt;&amp;nbsp;&amp;nbsp;Mọi thanh trong biểu đồ đều thấp lè tè. &lt;b&gt;Nó không hề biết mình đang trượt.&lt;/b&gt;&lt;br&gt;· Đổi embedder sang TF-IDF rồi hỏi bằng từ đồng nghĩa — cosine giữa &quot;xe hơi&quot; và &quot;ô tô&quot; bằng ĐÚNG 0.&lt;br&gt;· Mở tab So sánh, nhìn cột &lt;b&gt;tín/nhiễu&lt;/b&gt;: điểm câu trả lời được chia cho điểm câu lạc đề." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;align=left;verticalAlign=top;spacing=10;fontFamily=Segoe UI;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="960" height="130" as="geometry" />
        </mxCell>

